[7.076079, "o", "\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction animate(frames::Vector{<:UnicodePlots.Plot}; duration::Float64 = 0.5)\r\r\n\r\u001b[7C    print(\"\\x1b[?25l\") # hidecursor\r\r\n\r\u001b[7C    for (n, f) in enumerate(frames)\r\r\n\r\u001b[7C        print(f)\r\r\n\r\u001b[7C        str = string(f)\r\r\n\r\u001b[7C        if n != length(frames)\r\r\n\r\u001b[7C            sleep(duration)\r\r\n\r\u001b[7C            clearlines(length(collect(eachmatch(r\"\\n\", str))))\r\r\n\r\u001b[7C\r\u001b[7C        end"]
