[6.330597, "o", "\"\u001b[36mℯ\u001b[39m\" can be typed by "]
[6.330729, "o", "\u001b[36m\\euler<tab>\u001b[39m\r\r\n\r\r\nsearch:"]
[6.332494, "o", " \u001b[0m\u001b[1mℯ\u001b[22m\r\r\n\r\r\n"]
[6.332881, "o", "\u001b[1m\u001b[0m\u001b[0m"]
[6.333012, "o", "\u001b[36m  ℯ\u001b[39m\r\r\n\u001b[36m  e\u001b[39m\r\r\n\r\r\n  The constant ℯ.\r\r\n\r\r\n  Unicode \u001b[36mℯ\u001b[39m can be typed by writing \u001b[36m\\euler\u001b[39m and pressing tab in the Julia REPL,\r\r\n"]
[6.333074, "o", "  and in many editors.\r\r\n\r\r\n  See also: \u001b[36mexp\u001b[39m, \u001b[36mcis\u001b[39m, \u001b[36mcispi\u001b[39m.\r\r\n\r\r\n"]
[6.333264, "o", "\u001b[1m  Examples\u001b[22m\r\r\n\u001b[1m  ≡≡≡≡≡≡≡≡\u001b[22m\r\r\n\r\r\n\u001b[36m  julia> ℯ\u001b[39m\r\r\n\u001b[36m  ℯ = 2.7182818284590...\u001b[39m\r\r\n\u001b[36m  \u001b[39m\r\r\n\u001b[36m  julia> log(ℯ)\u001b[39m\r\r\n\u001b[36m  1\u001b[39m\r\r\n\u001b[36m  \u001b[39m\r\r\n\u001b[36m  julia> ℯ^(im)π ≈ -1\u001b[39m\r\r\n\u001b[36m  true\u001b[39m\r\r\n\r\r\n\r\u001b[0K\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7C\r\u001b[7C\u001b[?2004h\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7C\r\u001b[7C"]
