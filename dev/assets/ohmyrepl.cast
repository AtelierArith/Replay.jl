[12.624755, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.\u001b[0m\u001b[39m\"\u001b[0m\r\u001b[7C\r\u001b[28C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2\u001b[0m\u001b[39m\"\u001b[0m\r\u001b[7C\r\u001b[29C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\u001b[0m\u001b[39m\"\u001b[0m\r\u001b[7C\r\u001b[30C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\\"\u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[31C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m\r\u001b[7C\r\u001b[32C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m\r\u001b[7C\r\u001b[33C\u001b[?25h"]
[12.624981, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\r\u001b[7C\r\u001b[34C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[39ms\u001b[0m\r\u001b[7C\r\u001b[35C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[39msi\u001b[0m\r\u001b[7C\r\u001b[36C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[39msin\u001b[0m\r\u001b[7C\r\u001b[37C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[38C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mp\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[39C\u001b[?25h"]
[12.625191, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mpi\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[40C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mpi\u001b[0m\u001b[39m/\u001b[0m\u001b[39;101m\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[41C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mpi\u001b[0m\u001b[39m/\u001b[0m\u001b[38;5;141m4\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[42C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mpi\u001b[0m\u001b[39m/\u001b[0m\u001b[38;5;141m4\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[43C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m%.2f %.2f %.2f\\n\u001b[0m\u001b[39m\"\u001b[0m \u001b[0m\u001b[38;5;81msin\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mpi\u001b[