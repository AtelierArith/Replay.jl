[24.341942, "o", "function f(x)\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C\r\u001b[7C    # This is a comment\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C\r\u001b[7C    if x > 0\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C\r\u001b[7C        # x is larger than 0\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C        # x is larger than 0\r\r\n\r\u001b[7C\r\u001b[7C        @info \"x is larger than 0\"\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C        # x is larger than 0\r\r\n\r\u001b[7C        @info \"x is larger than 0\"\r\r\n\r\u001b[7C\r\u001b[7C    end\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C        # x is larger than 0\r\r\n\r\u001b[7C        @info \"x is larger than 0\"\r\r\n\r\u001b[7C    end\r\r\n\r\u001b[7C\r\u001b[7C    @info \"compute 2x + 2\"\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C        # x is larger than 0\r\r\n\r\u001b[7C        @info \"x is larger than 0\"\r\r\n\r\u001b[7C    end\r\r\n\r\u001b[7C    @info \"compute 2x + 2\"\r\r\n\r\u001b[7C\r\u001b[7C    2x + 2\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C        # x is larger than 0\r\r\n\r\u001b[7C        @info \"x is larger than 0\"\r\r\n\r\u001b[7C    end\r\r\n\r\u001b[7C    @info \"compute 2x + 2\"\r\r\n\r\u001b[7C    2x + 2\r\r\n\r\u001b[7C\r\u001b[7Cend\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[1A\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cfunction f(x)\r\r\n\r\u001b[7C    # This is a comment\r\r\n\r\u001b[7C    if x > 0\r\r\n\r\u001b[7C        # x is larger than 0\r\r\n\r\u001b[7C        @info \"x is larger than 0\"\r\r\n\r\u001b[7C    end\r\r\n\r\u001b[7C    @info \"compute 2x + 2\"\r\r\n\r\u001b[7C    2x + 2\r\r\n\r\u001b[7Cend\r\u001b[10C\r\r\n\u001b[?2004l\u001b[0m"]
