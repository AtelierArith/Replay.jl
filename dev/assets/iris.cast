[27.177585, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39miris\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mdataset\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185mdataset\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[30C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39miris\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mdataset\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185mdatasets\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[31C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39miris\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mdataset\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185mdatasets\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[32C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39miris\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mdataset\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185mdatasets\u001b[0m\u001b[39m\"\u001b[0m\u001b[39m,\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[33C\u001b[?25h"]
[27.177637, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39miris\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mdataset\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185mdatasets\u001b[0m\u001b[39m\"\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[34C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39miris\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mdataset\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185mdatasets\u001b[0m\u001b[39m\"\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;185m\u001b[0m\u001b[39m\"\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[35C\u001b[?25h"]
