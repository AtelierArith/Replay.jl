[69.251517, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81md\u001b[0m\r\u001b[7C\r\u001b[9C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m\r\u001b[7C\r\u001b[10C\u001b[?25h"]
