[60.002782, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39m@\u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[8C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mp\u001b[0m\r\u001b[7C\r\u001b[9C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mpr\u001b[0m\r\u001b[7C\r\u001b[10C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mpri\u001b[0m\r\u001b[7C\r\u001b[11C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprin\u001b[0m\r\u001b[7C\r\u001b[12C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprint\u001b[0m\r\u001b[7C\r\u001b[13C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mprintf\u001b[0m\r\u001b[7C\r\u001b[14C\u001b[?25h"]
