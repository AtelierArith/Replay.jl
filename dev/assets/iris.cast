[43.499835, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.=\u001b[0m \u001b[0m\u001b[39mX\u001b[0m \u001b[0m\r\u001b[7C\r\u001b[14C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.=\u001b[0m \u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[15C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.=\u001b[0m \u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39m-\u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[16C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.=\u001b[0m \u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39m-\u001b[0m \u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[17C\u001b[?25h"]
