[67.492733, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mDataFrame\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39me\u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39mvectors\u001b[0m\u001b[38;5;45m[\u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m1\u001b[0m\u001b[39m:\u001b[0m\u001b[39mtopk\u001b[0m\u001b[38;5;45m]\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;45;1;4m[\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[38;5;45;1;4m]\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[61C\u001b[?25h"]
[67.492803, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mDataFrame\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39me\u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39mvectors\u001b[0m\u001b[38;5;45m[\u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m1\u001b[0m\u001b[39m:\u001b[0m\u001b[39mtopk\u001b[0m\u001b[38;5;45m]\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;45;1;4m[\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m\u001b[38;5;45;1;4m]\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[62C\u001b[?25h"]
[67.492888, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mDataFrame\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39me\u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39mvectors\u001b[0m\u001b[38;5;45m[\u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m1\u001b[0m\u001b[39m:\u001b[0m\u001b[39mtopk\u001b[0m\u001b[38;5;45m]\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;45;1;4m[\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;45;1;4m]\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[63C\u001b[?25h"]
[67.492973, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mDataFrame\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39me\u001b[0m\u001b[38;5;197m.\u001b[0m\u001b[39mvectors\u001b[0m\u001b[38;5;45m[\u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m1\u001b[0m\u001b[39m:\u001b[0m\u001b[39mtopk\u001b[0m\u001b[38;5;45m]\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;45;1;4m[\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[38;5;45;1;4m]\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[64C\u001b[?25h"]
