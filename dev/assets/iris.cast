[69.251957, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_da\u001b[0m\r\u001b[7C\r\u001b[21C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_dat\u001b[0m\r\u001b[7C\r\u001b[22C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m\r\u001b[7C\r\u001b[23C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\r\u001b[7C\r\u001b[24C\u001b[?25h"]
[69.252079, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39ms\u001b[0m\r\u001b[7C\r\u001b[25C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39msc\u001b[0m\r\u001b[7C\r\u001b[26C\u001b[?25h"]
[69.252132, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39msca\u001b[0m\r\u001b[7C\r\u001b[27C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39mscat\u001b[0m\r\u001b[7C\r\u001b[28C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39mscatt\u001b[0m\r\u001b[7C\r\u001b[29C\u001b[?25h"]
[69.25217, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39mscatte\u001b[0m\r\u001b[7C\r\u001b[30C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[39mscatter\u001b[0m\r\u001b[7C\r\u001b[31C\u001b[?25h"]
[69.252357, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[32C\u001b[?25h"]
[69.252455, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[33C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[34C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[35C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[36C\u001b[?25h"]
[69.252559, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[37C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mY\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[38C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mY\u001b[0m\u001b[39m,\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[39C\u001b[?25h"]
[69.252651, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[38;5;81m@\u001b[0m\u001b[38;5;81mdf\u001b[0m \u001b[0m\u001b[39mreduced_data\u001b[0m \u001b[0m\u001b[38;5;81mscatter\u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mX\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mY\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[40C\u001b[?25h"]
