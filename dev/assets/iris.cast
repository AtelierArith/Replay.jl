[40.749254, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;197m:\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[36C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mS\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[37C\u001b[?25h"]
[40.749534, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mSp\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[38C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mSpe\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[39C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mSpec\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[40C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mSpeci\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[41C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mSpecie\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[42C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mX\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;81mMatrix\u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[38;5;81mselect\u001b[0m\u001b[38;5;161m(\u001b[0m\u001b[39miris\u001b[0m\u001b[39m,\u001b[0m \u001b[0m\u001b[38;5;81mNot\u001b[0m\u001b[38;5;34;1;4m(\u001b[0m\u001b[38;5;141m:\u001b[0m\u001b[38;5;141mSpecies\u001b[0m\u001b[38;5;34;1;4m)\u001b[0m\u001b[38;5;161m)\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[43C\u001b[?25h"]
