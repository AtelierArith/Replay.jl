[45.748266, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m\r\u001b[7C\r\u001b[8C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\r\u001b[7C\r\u001b[9C\u001b[?25h"]
[45.748315, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[10C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[11C\u001b[?25h"]
[45.748584, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[12C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[13C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[14C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[15C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m\u001b[39;101m\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[16C\u001b[?25h"]
[45.748751, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39;101m\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[17C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178;1;4m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178;1;4m)\u001b[0m\r\u001b[7C\r\u001b[18C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\r\u001b[7C\r\u001b[19C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39;101m\u001b[0m\r\u001b[7C\r\u001b[20C\u001b[?25h"]
[45.74893, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m\r\u001b[7C\r\u001b[21C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\r\u001b[7C\r\u001b[22C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m#\u001b[0m\r\u001b[7C\r\u001b[23C\u001b[?25h"]
[45.749093, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m# \u001b[0m\r\u001b[7C\r\u001b[24C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m# w\u001b[0m\r\u001b[7C\r\u001b[25C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m# wi\u001b[0m\r\u001b[7C\r\u001b[26C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m# wil\u001b[0m\r\u001b[7C\r\u001b[27C\u001b[?25h"]
[45.749137, "o", "\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m# will\u001b[0m\r\u001b[7C\r\u001b[28C\u001b[?25h\u001b[?25l\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[39mΣ\u001b[0m \u001b[0m\u001b[38;5;197m=\u001b[0m \u001b[0m\u001b[38;5;178m(\u001b[0m\u001b[39mX\u001b[0m\u001b[39m'\u001b[0m \u001b[0m\u001b[39m*\u001b[0m \u001b[0m\u001b[39mX\u001b[0m\u001b[38;5;178m)\u001b[0m\u001b[39m/\u001b[0m\u001b[39mN\u001b[0m \u001b[0m\u001b[38;5;240m# will \u001b[0m\r\u001b[7C\r\u001b[29C\u001b[?25h"]
